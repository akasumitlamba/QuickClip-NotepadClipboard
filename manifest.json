{
  "manifest_version": 3,
  "name": "QuickClip-NotepadClipboard",
  "version": "3.0",
  "description": "A simple clipboard/notepad tool for saving and managing text snippets",
  "permissions": [
    "storage",
    "clipboardWrite",
    "clipboardRead",
    "contextMenus",
    "notifications",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "save-selection-or-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save selected text or page URL to QuickClip"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
} 
